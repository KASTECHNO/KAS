# ============================================================
#  KAS - Configuration production OVH
#  Copier ce fichier en .env.production localement puis renseigner les secrets
#  Sur le serveur, renommer le fichier final en .env
# ============================================================

APP_NAME="KAS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kas-technology.com

# ---- Logs ----
LOG_CHANNEL=stack
LOG_LEVEL=error

# ---- Base de donnees MySQL OVH ----
DB_CONNECTION=mysql
DB_HOST=kastecj997.mysql.db
DB_PORT=3306
DB_DATABASE=kastecj997
DB_USERNAME=kastecj997
DB_PASSWORD=

# ---- Cache & Sessions ----
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ---- Mail (SMTP OVH ou autre) ----
MAIL_MAILER=smtp
MAIL_HOST=ssl0.ovh.net
MAIL_PORT=465
MAIL_USERNAME=contact@kas-technology.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=contact@kas-technology.com
MAIL_FROM_NAME="KAS"

# ---- Sanctum ----
SANCTUM_STATEFUL_DOMAINS=kas-technology.com,www.kas-technology.com

# ---- CORS ----
# Meme domaine: rien a ajouter ici
